# Application
APP_NAME=Enterprise Knowledge Assistant
API_PREFIX=/api/v1

# Security - MUST be changed in production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional Fernet key for encrypting provider API keys.
# If empty, it is derived from JWT_SECRET.
FERNET_KEY=

# Database (MySQL)
MYSQL_ROOT_PASSWORD=password
MYSQL_USER=raguser
MYSQL_PASSWORD=ragpass
MYSQL_DATABASE=ragdb
# DATABASE_URL overrides the individual MYSQL_* vars when set
# DATABASE_URL=mysql+pymysql://root:password@mysql:3306/ragdb?charset=utf8mb4

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
MEMORY_TURNS=5

# Default LLM provider (Ollama, local) - used when the user has no saved config
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma:2b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# Uploads
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50